// Secrets.example.xcconfig — template for local secrets.
//
// Copy this file to Secrets.xcconfig (same directory) and fill in real values.
// Secrets.xcconfig is gitignored and must never be committed.
//
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//
// The PostHog project token is a client-side ("phc_…") key. It ships inside the
// app bundle regardless — keeping it here just keeps it out of source control
// and lets each build/environment use its own token.

POSTHOG_PROJECT_TOKEN = phc_your_project_token_here
